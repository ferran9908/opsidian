{
  "name": "opsidian",
  "version": "0.0.0",
  "private": true,
  "description": "A Markdown-first notebook with self-hosted sync.",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @opsidian/desktop dev",
    "dev:preview": "pnpm --filter @opsidian/desktop dev:renderer",
    "dev:mobile": "pnpm build:mobile-editor && pnpm --filter @opsidian/mobile start",
    "build:desktop": "pnpm --filter @opsidian/desktop build",
    "build:mobile-editor": "node scripts/build-mobile-editor.mjs",
    "typecheck": "pnpm build:mobile-editor && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "test:desktop": "pnpm build:desktop && node scripts/test-desktop.mjs && node scripts/test-crash.mjs",
    "bench:desktop": "pnpm build:desktop && node scripts/bench-desktop.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "vitest": "5.0.2",
    "@types/node": "^24.0.0"
  }
}
